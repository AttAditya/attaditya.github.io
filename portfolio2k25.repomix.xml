import { useEffect, useCallback, useState } from "react";

export function LokiChar({ char }) {
  const [glyph, setGlyph] = useState(char);

  const updateGlyph = useCallback(() => {
    let character_alts = {
      "a": [
        "5039", "8704", "506", "945", "5609", "64",
        "570", "8371", "170", "197", "194", "478"
      ],
      "b": [
        "579", "9837", "595", "7685", "7686", "120"
      ],
      "c": [
        "8450", "231", "263", "265", "269", "9005"
      ],
      "d": [
        "5611", "394", "270", "271", "272", "273",
        "208", "8706", "8363", "545", "5798", "5799"
      ],
      "e": [
        "603", "275", "277", "279", "281", "283",
        "949", "1013", "706"
      ],
      "f": [
        "402", "8497", "64256", "981", "10069"
      ],
      "g": [
        "609", "285", "287", "289", "291", "947", "103"
      ],
      "h": [
        "295", "293", "7809", "7811", "104", "8459", "7838"
      ],
      "i": [
        "8464", "912", "302", "300", "205", "5062",
        "943", "906", "204", "5029", "205", "298", "304"
      ],
      "j": [
        "567", "309", "496", "943", "567", "120485"
      ],
      "k": [
        "409", "311", "312", "7731", "107", "313"
      ],
      "l": [
        "8466", "314", "316", "318", "737", "7735", "7737"
      ],
      "m": [
        "625", "7743", "7745", "7747", "109", "77", "9424"
      ],
      "n": [
        "8469", "241", "326", "328", "331", "110", "7749"
      ],
      "o": [
        "8709", "969", "248", "337", "339", "491",
        "333", "511", "8857"
      ],
      "p": [
        "8460", "960", "982", "254", "420", "112"
      ],
      "q": [
        "621", "640", "113", "410", "541"
      ],
      "r": [
        "8477", "341", "345", "343", "108", "630"
      ],
      "s": [
        "353", "347", "349", "351", "383", "115", "7835"
      ],
      "t": [
        "8224", "964", "354", "24178", "12490",
        "5055", "12486", "8366", "357", "7786"
      ],
      "u": [
        "751", "361", "363", "365", "367", "369", "371", "965"
      ],
      "v": [
        "118", "8744", "65286", "7805", "118"
      ],
      "w": [
        "7813", "7815", "7817", "969", "119"
      ],
      "x": [
        "120", "958", "120117", "9747", "10005", "8855"
      ],
      "y": [
        "611", "5033", "5053", "7822", "7823",
        "978", "612", "65509", "1506", "3062", "4280"
      ],
      "z": [
        "378", "380", "382", "950", "8488", "122"
      ],
      " ": [
        "160"
      ],
    };

    let ch = char.toLowerCase();

    let length = character_alts[ch].length;
    let random_index = Math.floor(Math.random() * length);
    let switch_char = character_alts[ch][random_index];

    let alt = String.fromCharCode(switch_char);
    setGlyph(alt);
  }, [char]);

  useEffect(() => {
    let interval = setInterval(updateGlyph, 1000);
    return () => clearInterval(interval);
  });

  return (<>
    <span value={char}>{glyph}</span>
  </>);
}
